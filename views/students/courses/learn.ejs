<!DOCTYPE html>

<html lang="en">

<head>


    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= course.title %> | XTP Academy
    </title>

    <link rel="stylesheet" href="/css/learn.css">


</head>

<body>


    <!-- SIDEBAR -->

    <aside class="sidebar" id="sidebar">

        <div class="sidebar-brand">

            <a href="/" class="brand-logo">
            X
        </a>

            <div class="brand-text">

                <h2>
                    XTP Academy
                </h2>

                <span>
                Learn. Build. Grow.
            </span>

            </div>

        </div>


        <div class="sidebar-section">

            <p class="sidebar-title">
                LEARNING
            </p>


            <a href="/" class="sidebar-link">

                <span class="sidebar-icon">
                ⌂
            </span>

                <span>
                Dashboard
            </span>

            </a>


            <a href="/courses" class="sidebar-link active">

                <span class="sidebar-icon">
                ▣
            </span>

                <span>
                Courses
            </span>

            </a>

        </div>


        <div class="sidebar-section">

            <p class="sidebar-title">
                ACCOUNT
            </p>


            <a href="/about" class="sidebar-link">

                <span class="sidebar-icon">
                ⓘ
            </span>

                <span>
                About Academy
            </span>

            </a>


            <a href="/contact" class="sidebar-link">

                <span class="sidebar-icon">
                ✉
            </span>

                <span>
                Support
            </span>

            </a>

        </div>


        <div class="sidebar-spacer"></div>


        <div class="sidebar-support">

            <div class="support-icon">
                ?
            </div>

            <h4>
                Need help?
            </h4>

            <p>
                Our support team is ready to help.
            </p>

            <a href="/contact">
            Contact us →
        </a>

        </div>


        <div class="sidebar-bottom">

            <a href="/logout" class="logout-link">

                <span class="sidebar-icon">
                ↪
            </span>

                <span>
                Logout
            </span>

            </a>


            <div class="sidebar-footer">

                <p>
                    ©
                    <%= new Date().getFullYear() %> XTP Academy
                </p>

                <span>
                All rights reserved.
            </span>

            </div>

        </div>

    </aside>



    <!-- MAIN CONTENT -->

    <main class="main-content">


        <!-- TOPBAR -->

        <header class="topbar">


            <div class="topbar-left">

                <button type="button" class="menu-toggle" id="menuToggle">
                ☰
            </button>


                <div class="breadcrumb">

                    <a href="/">
                    Academy
                </a>

                    <span>
                    ›
                </span>

                    <a href="/courses">
                    Courses
                </a>

                    <span>
                    ›
                </span>

                    <strong>
                    Learning
                </strong>

                </div>

            </div>



            <div class="topbar-right">


                <form class="top-search" action="/courses" method="GET">

                    <span>
                    ⌕
                </span>

                    <input type="search" name="search" placeholder="Search courses..." autocomplete="off">

                </form>


                <div class="profile">

                    <div class="profile-avatar">

                        <%= user && user.name
                        ? user.name.charAt(0).toUpperCase()
                        : "S"
                    %>

                    </div>


                    <div class="profile-info">

                        <strong>

                        <%= user && user.name
                            ? user.name
                            : "Student"
                        %>

                    </strong>

                        <span>
                        XTP Academy
                    </span>

                    </div>

                </div>

            </div>

        </header>



        <!-- PAGE -->

        <section class="learning-page">


            <!-- PAGE HEADER -->

            <div class="learning-heading">

                <div>

                    <span class="section-label">
                    COURSE PLAYER
                </span>

                    <h1>
                        <%= course.title %>
                    </h1>

                    <p>
                        Continue learning and build your skills.
                    </p>

                </div>


                <a href="/courses" class="back-courses">
                ← Back to Courses
            </a>

            </div>



            <!-- LEARNING GRID -->

            <div class="learning-grid">


                <!-- VIDEO AREA -->

                <section class="video-panel">


                    <div class="video-container">

                        <% if (course.video) { %>

                            <video id="courseVideo" class="course-video" controls preload="metadata" playsinline>

                            <source
                                src="/<%= course.video %>"
                                type="video/mp4"
                            >

                            Your browser does not support
                            HTML5 video.

                        </video>


                            <% } else { %>


                                <div class="video-unavailable">

                                    <div class="video-icon">
                                        ▶
                                    </div>

                                    <h2>
                                        Video unavailable
                                    </h2>

                                    <p>
                                        The course video has not been uploaded yet.
                                    </p>

                                </div>


                                <% } %>

                    </div>



                    <div class="video-information">


                        <div class="now-learning">

                            <span>
                            NOW LEARNING
                        </span>

                            <h2>
                                <%= course.title %>
                            </h2>

                        </div>


                        <div class="video-actions">

                            <button type="button" id="fullscreenBtn" class="video-action">
                            ⛶ Fullscreen
                        </button>

                        </div>

                    </div>

                </section>



                <!-- COURSE INFORMATION -->

                <aside class="course-sidebar">


                    <div class="course-card">


                        <% if (course.thumbnail) { %>

                            <div class="course-thumbnail">

                                <img src="/<%= course.thumbnail %>" alt="<%= course.title %>">

                                <div class="thumbnail-overlay">
                                    COURSE
                                </div>

                            </div>

                            <% } %>



                                <div class="course-content">


                                    <span class="course-category">
                            <%= course.category %>
                        </span>


                                    <h2>
                                        <%= course.title %>
                                    </h2>


                                    <div class="course-meta">


                                        <div class="meta-item">

                                            <span class="meta-icon">
                                    ◈
                                </span>

                                            <div>

                                                <small>
                                        LEVEL
                                    </small>

                                                <strong>
                                        <%= course.level %>
                                    </strong>

                                            </div>

                                        </div>


                                        <div class="meta-item">

                                            <span class="meta-icon">
                                    ✓
                                </span>

                                            <div>

                                                <small>
                                        ACCESS
                                    </small>

                                                <strong>
                                        Free Course
                                    </strong>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                    </div>



                    <!-- DESCRIPTION -->

                    <div class="description-card">

                        <div class="card-heading">

                            <div class="heading-icon">
                                i
                            </div>

                            <h3>
                                About This Course
                            </h3>

                        </div>


                        <p>
                            <%= course.description %>
                        </p>

                    </div>



                    <!-- COURSE ACTIONS -->

                    <div class="action-card">

                        <h3>
                            Keep Learning
                        </h3>

                        <p>
                            Explore more courses and continue developing your skills.
                        </p>


                        <a href="/courses" class="primary-button">
                        Browse More Courses
                    </a>


                        <a href="/" class="secondary-button">
                        Go to Dashboard
                    </a>

                    </div>


                </aside>

            </div>

        </section>



        <!-- FOOTER -->

        <footer class="main-footer">

            <div>

                <strong>
                XTP Academy
            </strong>

                <span>
                Learn. Build. Grow.
            </span>

            </div>


            <div class="footer-links">

                <a href="/terms">
                Terms & Conditions
            </a>

                <a href="/privacy">
                Privacy Policy
            </a>

                <a href="/contact">
                Support
            </a>

            </div>


            <p>
                ©
                <%= new Date().getFullYear() %>
                    XTP Academy. All rights reserved.
            </p>

        </footer>

    </main>



    <script src="/js/learn.js"></script>


</body>

</html>