<!DOCTYPE html>

<html lang="en">

<head>


    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="XTP Concept Academy Student Dashboard">

    <meta name="theme-color" content="#111827">

    <title>XTP Concept Academy | Student Dashboard</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/students.css">


</head>

<body>


    <div class="student-layout">

        <!-- =====================================================
         SIDEBAR
    ====================================================== -->

        <aside class="sidebar" id="studentSidebar">


            <div class="brand">

                <a href="/" class="brand-link">

                    <div class="brand-logo">
                        X
                    </div>

                    <div class="brand-text">

                        <strong>XTP</strong>

                        <span>CONCEPT ACADEMY</span>

                    </div>

                </a>

            </div>


            <div class="sidebar-section">

                <span class="sidebar-title">
                LEARNING
            </span>

                <nav class="sidebar-nav">

                    <a href="/" class="nav-item active">

                        <span class="nav-icon">⌂</span>

                        <span>Dashboard</span>

                    </a>


                    <a href="/courses" class="nav-item">

                        <span class="nav-icon">▤</span>

                        <span>Courses</span>

                    </a>

                </nav>

            </div>


            <div class="sidebar-section">

                <span class="sidebar-title">
                ACCOUNT
            </span>

                <nav class="sidebar-nav">

                    <a href="/about" class="nav-item">

                        <span class="nav-icon">?</span>

                        <span>About Academy</span>

                    </a>


                    <a href="/contact" class="nav-item">

                        <span class="nav-icon">✉</span>

                        <span>Support</span>

                    </a>

                </nav>

            </div>


            <div class="sidebar-bottom">

                <div class="support-card">

                    <div class="support-icon">
                        ✦
                    </div>

                    <strong>
                    Keep learning
                </strong>

                    <small>
                    One skill can create a new opportunity.
                </small>

                </div>


                <a href="/logout" class="nav-item logout-item">

                    <span class="nav-icon">↪</span>

                    <span>Logout</span>

                </a>


                <div class="sidebar-footer">
                    XTP Concept Academy
                </div>

            </div>


        </aside>


        <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

        <main class="main-content">


            <!-- TOPBAR -->

            <header class="topbar">

                <div class="topbar-left">

                    <button type="button" class="menu-toggle" id="mobileMenuBtn" aria-label="Open menu">

                    ☰

                </button>

                    <div class="page-heading">

                        <span class="breadcrumb">
                        Student Portal / Dashboard
                    </span>

                        <h1>
                            Dashboard
                        </h1>

                    </div>

                </div>


                <div class="topbar-right">

                    <form action="/courses" method="GET" class="topbar-search">

                        <span>
                        ⌕
                    </span>

                        <input type="search" name="search" id="studentNavbarSearch" placeholder="Search courses..." autocomplete="off">

                    </form>


                    <div class="profile">

                        <div class="profile-avatar">

                            <%= user.name.charAt(0).toUpperCase() %>

                        </div>

                        <div class="profile-info">

                            <span>
                            Welcome back
                        </span>

                            <strong>
                            <%= user.name %>
                        </strong>

                        </div>

                    </div>

                </div>

            </header>


            <!-- =====================================================
             DASHBOARD CONTENT
        ====================================================== -->

            <div class="dashboard-content">


                <!-- WELCOME -->

                <section class="welcome-section">

                    <div>

                        <span class="welcome-label">
                        YOUR LEARNING SPACE
                    </span>

                        <h2>
                            Welcome back,
                            <%= user.name %> 👋
                        </h2>

                        <p>
                            Continue learning, explore new skills and build your future with XTP Concept Academy.
                        </p>

                    </div>

                    <a href="/courses" class="primary-button">

                    Explore Courses

                    <span>→</span>

                </a>

                </section>


                <!-- =================================================
                 STATS
            ================================================== -->

                <section class="stats-grid">


                    <div class="stat-card">

                        <div class="stat-icon purple">
                            ▣
                        </div>

                        <div class="stat-content">

                            <span>
                            Available Courses
                        </span>

                            <strong>
                            <%= data ? data.length : 0 %>
                        </strong>

                            <small>
                            Courses ready to explore
                        </small>

                        </div>

                    </div>


                    <div class="stat-card">

                        <div class="stat-icon blue">
                            ◎
                        </div>

                        <div class="stat-content">

                            <span>
                            Career Areas
                        </span>

                            <strong>
                            12+
                        </strong>

                            <small>
                            Different paths to explore
                        </small>

                        </div>

                    </div>


                    <div class="stat-card">

                        <div class="stat-icon green">
                            ✓
                        </div>

                        <div class="stat-content">

                            <span>
                            Learning Focus
                        </span>

                            <strong>
                            100%
                        </strong>

                            <small>
                            Practical learning approach
                        </small>

                        </div>

                    </div>


                    <div class="stat-card">

                        <div class="stat-icon orange">
                            ★
                        </div>

                        <div class="stat-content">

                            <span>
                            Learning Model
                        </span>

                            <strong>
                            4 Steps
                        </strong>

                            <small>
                            Learn → Practice → Build → Grow
                        </small>

                        </div>

                    </div>


                </section>


                <!-- =================================================
                 MAIN DASHBOARD ROW
            ================================================== -->

                <div class="dashboard-row">


                    <!-- LEARNING PANEL -->

                    <section class="panel learning-panel">

                        <div class="panel-header">

                            <div>

                                <span class="panel-label">
                                LEARNING JOURNEY
                            </span>

                                <h2>
                                    Keep building your skills
                                </h2>

                            </div>

                            <span class="panel-icon">
                            ✦
                        </span>

                        </div>


                        <div class="learning-progress">

                            <div class="progress-top">

                                <div>

                                    <strong>
                                    Your learning journey
                                </strong>

                                    <span>
                                    Learn → Practice → Build → Grow
                                </span>

                                </div>

                                <strong class="progress-value">
                                75%
                            </strong>

                            </div>


                            <div class="progress-track">

                                <span style="width: 75%;"></span>

                            </div>


                            <div class="progress-footer">

                                <span>
                                Keep going — you're making progress.
                            </span>

                                <a href="/courses">
                                Continue →
                            </a>

                            </div>

                        </div>


                        <div class="learning-model-grid">

                            <div class="model-item active">

                                <span>01</span>

                                <strong>Learn</strong>

                                <small>Understand concepts</small>

                            </div>

                            <div class="model-item">

                                <span>02</span>

                                <strong>Practice</strong>

                                <small>Test your knowledge</small>

                            </div>

                            <div class="model-item">

                                <span>03</span>

                                <strong>Build</strong>

                                <small>Create projects</small>

                            </div>

                            <div class="model-item">

                                <span>04</span>

                                <strong>Grow</strong>

                                <small>Develop your career</small>

                            </div>

                        </div>

                    </section>


                    <!-- QUICK ACTIONS -->

                    <section class="panel quick-panel">

                        <div class="panel-header">

                            <div>

                                <span class="panel-label">
                                QUICK ACTIONS
                            </span>

                                <h2>
                                    Get started
                                </h2>

                            </div>

                        </div>


                        <div class="quick-actions">

                            <a href="/courses" class="quick-action">

                                <div class="quick-icon">
                                    ▤
                                </div>

                                <div>

                                    <strong>
                                    Browse Courses
                                </strong>

                                    <span>
                                    Find something new to learn
                                </span>

                                </div>

                                <b>→</b>

                            </a>


                            <a href="#career-paths" class="quick-action">

                                <div class="quick-icon">
                                    ◎
                                </div>

                                <div>

                                    <strong>
                                    Career Paths
                                </strong>

                                    <span>
                                    Choose your direction
                                </span>

                                </div>

                                <b>→</b>

                            </a>


                            <a href="/categories" class="quick-action">

                                <div class="quick-icon">
                                    ◈
                                </div>

                                <div>

                                    <strong>
                                    Categories
                                </strong>

                                    <span>
                                    Explore different skills
                                </span>

                                </div>

                                <b>→</b>

                            </a>

                        </div>

                    </section>

                </div>


                <!-- =================================================
                 COURSES
            ================================================== -->

                <section class="panel courses-panel" id="courses">

                    <div class="panel-header">

                        <div>

                            <span class="panel-label">
                            AVAILABLE COURSES
                        </span>

                            <h2>
                                Courses for your growth
                            </h2>

                            <p>
                                Explore practical courses and start developing useful skills.
                            </p>

                        </div>

                        <a href="/courses" class="panel-link">
                        View all →
                    </a>

                    </div>


                    <% if (!data || data.length === 0) { %>

                        <div class="empty-state">

                            <div class="empty-icon">
                                📚
                            </div>

                            <h3>
                                No courses available yet
                            </h3>

                            <p>
                                New courses will appear here when they are published.
                            </p>

                            <a href="/courses" class="primary-button">
                            Browse Courses
                        </a>

                        </div>

                        <% } else { %>

                            <div class="course-grid">

                                <% data.forEach(datum => { %>

                                    <article class="course-card">

                                        <a href="/courses/<%= datum._id %>/learn" class="course-image">

                                    <img
                                        src="/<%= datum.thumbnail %>"
                                        alt="<%= datum.title %>"
                                        loading="lazy"
                                    >

                                    <div class="course-overlay">

                                        <span>
                                            <%= datum.category %>
                                        </span>

                                    </div>

                                </a>


                                        <div class="course-content">

                                            <div class="course-top">

                                                <span class="course-category">
                                            <%= datum.category %>
                                        </span>

                                                <span class="course-level">
                                            <%= datum.level %>
                                        </span>

                                            </div>


                                            <h3>

                                                <a href="/courses/<%= datum._id %>">
                                                    <%= datum.title %>
                                                </a>

                                            </h3>


                                            <p>

                                                <%= datum.description &&
                                        datum.description.length > 110
                                        ? datum.description.substring(0, 110) + "..."
                                        : datum.description %>

                                            </p>


                                            <div class="course-meta">

                                                <span>
                                            ★ 4.9
                                        </span>

                                                <span>
                                            XTP Academy
                                        </span>

                                            </div>


                                            <div class="course-footer">

                                                <strong>
                                            Free
                                        </strong>

                                                <a href="/courses/<%= datum._id %>/learn" class="course-button">
                                            Start Learning
                                        </a>

                                            </div>

                                        </div>

                                    </article>

                                    <% }) %>

                            </div>

                            <% } %>


                                <div class="center-button">

                                    <a href="/courses" class="outline-button">
                        Explore Every Course →
                    </a>

                                </div>

                </section>


                <!-- =================================================
                 CAREER PATHS
            ================================================== -->

                <section class="panel career-panel" id="career-paths">

                    <div class="panel-header">

                        <div>

                            <span class="panel-label">
                            CAREER PATHS
                        </span>

                            <h2>
                                Choose your direction
                            </h2>

                            <p>
                                Explore technology, business, creative and digital career paths.
                            </p>

                        </div>

                        <a href="/categories" class="panel-link">
                        View all →
                    </a>

                    </div>


                    <div class="career-grid">


                        <a href="/courses?category=development" class="career-card">

                            <div class="career-icon purple">
                                &lt;/&gt;
                            </div>

                            <div>

                                <span>01</span>

                                <h3>
                                    Software Development
                                </h3>

                                <p>
                                    Web, backend, mobile and software engineering.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=cybersecurity" class="career-card">

                            <div class="career-icon red">
                                🛡
                            </div>

                            <div>

                                <span>02</span>

                                <h3>
                                    Cybersecurity
                                </h3>

                                <p>
                                    Security fundamentals and responsible defense.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=hacking" class="career-card">

                            <div class="career-icon dark">
                                ⚡
                            </div>

                            <div>

                                <span>03</span>

                                <h3>
                                    Ethical Hacking
                                </h3>

                                <p>
                                    Responsible security testing and penetration concepts.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=data" class="career-card">

                            <div class="career-icon blue">
                                ◫
                            </div>

                            <div>

                                <span>04</span>

                                <h3>
                                    Data Analysis
                                </h3>

                                <p>
                                    Excel, SQL, visualization and data insights.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=ai" class="career-card">

                            <div class="career-icon violet">
                                AI
                            </div>

                            <div>

                                <span>05</span>

                                <h3>
                                    AI & Machine Learning
                                </h3>

                                <p>
                                    Artificial intelligence and intelligent applications.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=cloud" class="career-card">

                            <div class="career-icon cyan">
                                ☁
                            </div>

                            <div>

                                <span>06</span>

                                <h3>
                                    Cloud Computing
                                </h3>

                                <p>
                                    Cloud infrastructure and modern deployment.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=networking" class="career-card">

                            <div class="career-icon green">
                                ◎
                            </div>

                            <div>

                                <span>07</span>

                                <h3>
                                    Networking
                                </h3>

                                <p>
                                    Networks, servers and digital connectivity.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=design" class="career-card">

                            <div class="career-icon orange">
                                ✦
                            </div>

                            <div>

                                <span>08</span>

                                <h3>
                                    UI/UX & Design
                                </h3>

                                <p>
                                    User experience, interfaces and creative design.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=business" class="career-card">

                            <div class="career-icon gold">
                                ◈
                            </div>

                            <div>

                                <span>09</span>

                                <h3>
                                    Business & Entrepreneurship
                                </h3>

                                <p>
                                    Entrepreneurship and digital business opportunities.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=marketing" class="career-card">

                            <div class="career-icon pink">
                                ◎
                            </div>

                            <div>

                                <span>10</span>

                                <h3>
                                    Digital Marketing
                                </h3>

                                <p>
                                    Social media, content, branding and online growth.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=it" class="career-card">

                            <div class="career-icon slate">
                                ⌘
                            </div>

                            <div>

                                <span>11</span>

                                <h3>
                                    IT Support
                                </h3>

                                <p>
                                    Computer support and IT fundamentals.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                        <a href="/courses?category=mobile" class="career-card">

                            <div class="career-icon teal">
                                ▣
                            </div>

                            <div>

                                <span>12</span>

                                <h3>
                                    Mobile Development
                                </h3>

                                <p>
                                    Android, iOS and cross-platform applications.
                                </p>

                            </div>

                            <strong>→</strong>

                        </a>


                    </div>

                </section>


                <!-- =================================================
                 SKILLS
            ================================================== -->

                <section class="skills-panel">

                    <div class="skills-content">

                        <span class="panel-label light">
                        SKILLS FOR THE FUTURE
                    </span>

                        <h2>
                            Build a complete digital skill set.
                        </h2>

                        <p>
                            Technology careers are bigger than programming. Explore the skills you need for the modern digital world.
                        </p>

                    </div>


                    <div class="skills-list">

                        <span>JavaScript</span>
                        <span>Python</span>
                        <span>Cybersecurity</span>
                        <span>Ethical Hacking</span>
                        <span>Data Analysis</span>
                        <span>SQL</span>
                        <span>Artificial Intelligence</span>
                        <span>Machine Learning</span>
                        <span>Cloud Computing</span>
                        <span>Networking</span>
                        <span>UI/UX</span>
                        <span>Graphics Design</span>
                        <span>Digital Marketing</span>
                        <span>IT Support</span>
                        <span>Mobile Development</span>
                        <span>Entrepreneurship</span>

                    </div>

                </section>


                <!-- =================================================
                 WHY XTP
            ================================================== -->

                <div class="dashboard-row lower-row">


                    <section class="panel benefits-panel">

                        <div class="panel-header">

                            <div>

                                <span class="panel-label">
                                WHY XTP ACADEMY
                            </span>

                                <h2>
                                    Turn knowledge into ability.
                                </h2>

                                <p>
                                    Our learning approach focuses on useful knowledge and practical application.
                                </p>

                            </div>

                        </div>


                        <div class="benefit-grid">

                            <div class="benefit">

                                <div class="benefit-icon">
                                    ✓
                                </div>

                                <div>

                                    <h3>
                                        Practical Skills
                                    </h3>

                                    <p>
                                        Focus on useful knowledge and practical application.
                                    </p>

                                </div>

                            </div>


                            <div class="benefit">

                                <div class="benefit-icon">
                                    ⚡
                                </div>

                                <div>

                                    <h3>
                                        Learn at Your Pace
                                    </h3>

                                    <p>
                                        Continue learning whenever you are ready.
                                    </p>

                                </div>

                            </div>


                            <div class="benefit">

                                <div class="benefit-icon">
                                    ◈
                                </div>

                                <div>

                                    <h3>
                                        Multiple Career Paths
                                    </h3>

                                    <p>
                                        Explore technology, business and creative careers.
                                    </p>

                                </div>

                            </div>


                            <div class="benefit">

                                <div class="benefit-icon">
                                    ★
                                </div>

                                <div>

                                    <h3>
                                        Career Growth
                                    </h3>

                                    <p>
                                        Build skills that prepare you for future opportunities.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </section>


                    <section class="panel model-panel">

                        <div class="model-header">

                            <span>
                            XTP LEARNING MODEL
                        </span>

                            <div>
                                ✦
                            </div>

                        </div>


                        <div class="model-step">

                            <span>01</span>

                            <div>

                                <strong>Learn</strong>

                                <small>
                                Understand the concept.
                            </small>

                            </div>

                        </div>


                        <div class="model-line"></div>


                        <div class="model-step">

                            <span>02</span>

                            <div>

                                <strong>Practice</strong>

                                <small>
                                Test your understanding.
                            </small>

                            </div>

                        </div>


                        <div class="model-line"></div>


                        <div class="model-step">

                            <span>03</span>

                            <div>

                                <strong>Build</strong>

                                <small>
                                Turn knowledge into projects.
                            </small>

                            </div>

                        </div>


                        <div class="model-line"></div>


                        <div class="model-step">

                            <span>04</span>

                            <div>

                                <strong>Grow</strong>

                                <small>
                                Keep developing your career.
                            </small>

                            </div>

                        </div>

                    </section>

                </div>


                <!-- =================================================
                 PROCESS
            ================================================== -->

                <section class="panel process-panel">

                    <div class="panel-header centered">

                        <div>

                            <span class="panel-label">
                            SIMPLE PROCESS
                        </span>

                            <h2>
                                Your learning journey starts here.
                            </h2>

                            <p>
                                Go from discovering a skill to building your knowledge in four simple steps.
                            </p>

                        </div>

                    </div>


                    <div class="process-grid">


                        <div class="process-card">

                            <span>01</span>

                            <div class="process-icon">
                                ⌕
                            </div>

                            <h3>
                                Choose a Skill
                            </h3>

                            <p>
                                Explore different career areas and find something you want to learn.
                            </p>

                        </div>


                        <div class="process-card">

                            <span>02</span>

                            <div class="process-icon">
                                📚
                            </div>

                            <h3>
                                Learn
                            </h3>

                            <p>
                                Follow lessons and develop your understanding.
                            </p>

                        </div>


                        <div class="process-card">

                            <span>03</span>

                            <div class="process-icon">
                                ⚙
                            </div>

                            <h3>
                                Practice
                            </h3>

                            <p>
                                Apply what you learn through practical activities.
                            </p>

                        </div>


                        <div class="process-card">

                            <span>04</span>

                            <div class="process-icon">
                                🚀
                            </div>

                            <h3>
                                Build Your Future
                            </h3>

                            <p>
                                Continue improving your skills and prepare for opportunities.
                            </p>

                        </div>


                    </div>

                </section>


                <!-- =================================================
                 CTA
            ================================================== -->

                <section class="final-cta">

                    <div>

                        <span class="panel-label light">
                        YOUR FUTURE STARTS WITH A SKILL
                    </span>

                        <h2>
                            What will you learn next?
                        </h2>

                        <p>
                            Start building practical skills today and prepare yourself for future opportunities.
                        </p>

                    </div>


                    <div class="cta-actions">

                        <a href="/courses" class="cta-primary">
                        Explore Courses →
                    </a>

                        <a href="/categories" class="cta-secondary">
                        Career Areas
                    </a>

                    </div>

                </section>


                <!-- FOOTER -->

                <footer class="footer">

                    <div>

                        <strong>
                        XTP Concept Academy
                    </strong>

                        <p>
                            Learn. Build. Grow.
                        </p>

                    </div>

                    <div>

                        <a href="/about">
                        About
                    </a>

                        <a href="/contact">
