    <!-- =====================================================
     COURSE SECTION
===================================================== -->

    <section class="section courses-section" id="courses">

        <div class="container">


            <div class="section-heading">

                <div>

                    <span class="section-label">
                    LEARN SOMETHING NEW
                </span>

                    <h2>
                        Courses built for your growth
                    </h2>

                    <p>
                        Explore available courses and start developing practical skills.
                    </p>

                </div>

                <a href="/courses" class="section-link">
                Browse all courses →
            </a>

            </div>



            <% if (!data || data.length === 0) { %>


                <div class="empty-state">

                    <div class="empty-icon">
                        📚
                    </div>

                    <h3>
                        No courses available yet
                    </h3>

                    <p>
                        New courses will appear here when they are published.
                    </p>

                    <a href="/courses" class="primary-button">
                    Browse Courses
                </a>

                </div>


                <% } else { %>


                    <div class="course-grid">


                        <% data.forEach(datum => { %>


                            <article class="course-card">


                                <a href="/courses/<%= datum._id %>/learn" class="course-image">

                            <img
                                src="/<%= datum.thumbnail %>"
                                alt="<%= datum.title %>"
                                loading="lazy"
                            >


                            <div class="course-overlay">

                                <span>
                                    <%= datum.category %>
                                </span>

                            </div>

                        </a>



                                <div class="course-content">


                                    <div class="course-top-row">

                                        <span class="course-category">
                                    <%= datum.category %>
                                </span>

                                        <span class="course-level">
                                    <%= datum.level %>
                                </span>

                                    </div>



                                    <h3>

                                        <a href="/courses/<%= datum._id %>">
                                            <%= datum.title %>
                                        </a>

                                    </h3>



                                    <p class="course-description">

                                        <%= datum.description &&
                                datum.description.length > 110
                                ? datum.description.substring(0, 110) + "..."
                                : datum.description %>

                                    </p>



                                    <div class="course-meta">

                                        <span>
                                    ✦ 4.9
                                </span>

                                        <span>
                                    •
                                </span>

                                        <span>
                                    XTP Academy
                                </span>

                                    </div>



                                    <div class="course-footer">

                                        <div>

                                            <strong class="course-price">
                                        Free
                                    </strong>

                                        </div>


                                        <a href="/courses/<%= datum._id %>/learn" class="course-button">
                                    Start Learning
                                </a>

                                    </div>


                                </div>


                            </article>


                            <% }) %>


                    </div>


                    <% } %>



                        <div class="center-button">

                            <a href="/courses" class="outline-button">
                Explore Every Course →
            </a>

                        </div>


        </div>

    </section>



