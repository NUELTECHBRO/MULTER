<body>


    <!-- =====================================================
     ANNOUNCEMENT
===================================================== -->

    <div class="announcement">

        <div class="container announcement-inner">

            <div class="announcement-message">

                <span class="announcement-dot"></span>

                <span>
                Learn skills. Build projects. Grow your career.
            </span>

            </div>

            <a href="/courses">
            Explore courses →
        </a>

        </div>

    </div>



    <!-- =====================================================
     NAVBAR
===================================================== -->

    <header class="navbar">

        <div class="container nav-container">


            <!-- BRAND -->

            <a href="/" class="brand">

                <div class="brand-logo">
                    X
                </div>

                <div class="brand-text">

                    <strong>
                    XTP
                </strong>

                    <span>
                    CONCEPT ACADEMY
                </span>

                </div>

            </a>



            <!-- SEARCH -->

            <form action="/courses" method="GET" class="navbar-search">

                <span class="search-symbol">
                ⌕
            </span>

                <input type="search" name="search" placeholder="Search courses, skills and careers..." autocomplete="off" aria-label="Search courses">

                <button type="submit">
                Search
            </button>

            </form>



            <!-- NAVIGATION -->

            <nav class="nav-links">

                <a href="/" class="active">
                Home
            </a>

                <a href="/courses">
                Courses
            </a>

                <a href="/categories">
                Categories
            </a>

                <a href="/about">
                About
            </a>

            </nav>



            <!-- ACCOUNT -->

            <div class="account-area">

                <div class="account-avatar">

                    <%= user.name.charAt(0).toUpperCase() %>

                </div>

                <div class="account-info">

                    <span>
                    Welcome back
                </span>

                    <strong>
                    <%= user.name %>
                </strong>

                </div>

                <a href="/logout" class="logout-link">
                Logout
            </a>

            </div>



            <!-- MOBILE BUTTON -->

            <button type="button" class="mobile-menu-button" id="mobileMenuBtn" aria-label="Open navigation" aria-expanded="false">
            ☰
        </button>

        </div>



        <!-- MOBILE MENU -->

        <div class="mobile-menu" id="mobileMenu">

            <form action="/courses" method="GET" class="mobile-search">

                <input type="search" name="search" placeholder="Search courses...">

                <button type="submit">
                Search
            </button>

            </form>


            <a href="/">
            Home
        </a>

            <a href="/courses">
            Courses
        </a>

            <a href="/categories">
            Categories
        </a>

            <a href="/about">
            About
        </a>

            <a href="/logout" class="mobile-logout">
            Logout
        </a>

        </div>

    </header>



    <!-- =====================================================
     HERO
===================================================== -->

