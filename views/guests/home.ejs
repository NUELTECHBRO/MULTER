                            </p>


                        </div>



                        <div class="step-card">

                            <span class="step-number">
                
                            03
                
                        </span>


                            <div class="step-icon">

                                🚀

                            </div>


                            <h3>

                                Start Learning

                            </h3>


                            <p>

