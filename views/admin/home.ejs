<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XTP Concept Academy | Admin Dashboard</title>


    <link rel="stylesheet" href="/css/admin.css">



</head>

<body>

    <% 
        const stats = locals.stats || {
            totalStudents: 0,
            totalCourses: 0,
            totalEnrollments: 0,
            totalCategories: 0,
            studentsThisMonth: 0,
            coursesThisMonth: 0,
            enrollmentsThisMonth: 0,
            studentGrowth: 0,
            courseGrowth: 0,
            enrollmentGrowth: 0,
            enrollmentChart: []
        };
        const recentStudents = (locals.recentStudents || []).slice(0, 4);
        const topCourses = (locals.topCourses || []).slice(0, 4);
        const studentInitials = (name) => (name || "Student").trim().split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase();
        const growthLabel = (growth) => growth === null ? "New" : `${Math.abs(growth).toFixed(1)}%`;
        const growthIcon = (growth) => growth >= 0 ? "fa-arrow-up" : "fa-arrow-down";
        const growthClass = (growth) => growth >= 0 ? "positive" : "negative";
        const chartMaximum = Math.max(1, ...stats.enrollmentChart.map((month) => month.count));
        const chartLine = stats.enrollmentChart.map((month, index) => {
            const x = index * 700 / (stats.enrollmentChart.length - 1);
            const y = 230 - (month.count / chartMaximum) * 200;
            return `${index === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`;
        }).join(" ");
        const chartFill = `${chartLine} L700,260 L0,260 Z`;
    %>

    <div class="admin-layout">


        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">

            <div class="brand">
                <div class="brand-logo">X</div>

                <div class="brand-text">
                    <h2>XTP</h2>
                    <span>CONCEPT ACADEMY</span>
                </div>
            </div>

            <div class="sidebar-section">
                <p class="section-title">MAIN MENU</p>

                <nav class="sidebar-nav">

                    <a href="/admin" class="nav-item active">
                        <i class="fa-solid fa-grid-2"></i>
                        <span>Dashboard</span>
                    </a>

                    <a href="/admin/courses/upload" class="nav-item">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        <span>Upload Courses</span>
                    </a>

                    <a href="/admin/courses" class="nav-item">
                        <i class="fa-solid fa-book-open"></i>
                        <span>Manage Courses</span>
                    </a>

                    <a href="/admin/students" class="nav-item">
                        <i class="fa-solid fa-user-graduate"></i>
                        <span>Students</span>
                    </a>

                    <a href="/admin/payments" class="nav-item">
                        <i class="fa-solid fa-credit-card"></i>
                        <span>Payments</span>
                    </a>

                </nav>
            </div>

            <div class="sidebar-section second-menu">
                <p class="section-title">SYSTEM</p>

                <nav class="sidebar-nav">

                    <a href="/admin/settings" class="nav-item">
                        <i class="fa-solid fa-gear"></i>
                        <span>Settings</span>
                    </a>

                    <a href="/logout" class="nav-item logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Logout</span>
                    </a>

                </nav>
            </div>

            <div class="sidebar-bottom">

                <div class="support-card">
                    <div class="support-icon">
                        <i class="fa-solid fa-circle-question"></i>
                    </div>

                    <div>
                        <strong>Need Help?</strong>
                        <small>Contact Academy Support</small>
                    </div>
                </div>

                <div class="sidebar-footer">
                    <span>© 2026 XTP Concept Academy</span>
                </div>

            </div>

        </aside>


        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- TOPBAR -->
            <header class="topbar">

                <div class="topbar-left">

                    <button class="menu-toggle" id="menuToggle">
                <i class="fa-solid fa-bars"></i>
            </button>

                    <div>
                        <span class="breadcrumb">Admin / Dashboard</span>
                        <h1>Dashboard</h1>
                    </div>

                </div>

                <div class="topbar-right">

                    <button class="icon-button" title="Notifications">
                <i class="fa-regular fa-bell"></i>
                <span class="notification-dot"></span>
            </button>

                    <div class="admin-profile">

                        <div class="admin-avatar">
                            AD
                        </div>

                        <div class="admin-info">
                            <strong>Academy Admin</strong>
                            <span>Administrator</span>
                        </div>

                        <i class="fa-solid fa-chevron-down profile-arrow"></i>

                    </div>

                </div>

            </header>


            <!-- DASHBOARD -->
            <section class="dashboard-content">

                <!-- WELCOME -->
                <div class="welcome-section">

                    <div>
                        <span class="welcome-label">WELCOME BACK 👋</span>
                        <h2>Good day,
                            <%= user.name%>
                        </h2>
                        <p>
                            Here's what's happening across XTP Concept Academy today.
                        </p>
                    </div>

                    <a href="/admin/courses/upload" class="primary-button">
                        <i class="fa-solid fa-plus"></i> Create New Course
                    </a>

                </div>


                <!-- STATISTICS -->
                <div class="stats-grid">

                    <div class="stat-card">

                        <div class="stat-top">
                            <div class="stat-icon students">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>

                            <span class="trend <%= growthClass(stats.studentGrowth) %>">
                        <i class="fa-solid <%= growthIcon(stats.studentGrowth) %>"></i>
                        <%= growthLabel(stats.studentGrowth) %>
                    </span>
                        </div>

                        <span class="stat-label">Total Students</span>

                        <div class="stat-value">
                            <%= stats.totalStudents %>
                        </div>

                        <span class="stat-description">
                    Compared with last month
                </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-top">
                            <div class="stat-icon courses">
                                <i class="fa-solid fa-book-open"></i>
                            </div>

                            <span class="trend <%= growthClass(stats.courseGrowth) %>">
                        <i class="fa-solid <%= growthIcon(stats.courseGrowth) %>"></i>
                        <%= growthLabel(stats.courseGrowth) %>
                    </span>
                        </div>

                        <span class="stat-label">Published Courses</span>

                        <div class="stat-value"><%= stats.totalCourses %></div>

                        <span class="stat-description">
                    <%= stats.coursesThisMonth %> courses added this month
                </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-top">
                            <div class="stat-icon revenue">
                                <i class="fa-solid fa-tags"></i>
                            </div>
                        </div>

                        <span class="stat-label">Course Categories</span>

                        <div class="stat-value"><%= stats.totalCategories %></div>

                        <span class="stat-description">
                    Different categories in the catalog
                </span>

                    </div>


                    <div class="stat-card">

                        <div class="stat-top">
                            <div class="stat-icon enrollment">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>

                            <span class="trend <%= growthClass(stats.enrollmentGrowth) %>">
                        <i class="fa-solid <%= growthIcon(stats.enrollmentGrowth) %>"></i>
                        <%= growthLabel(stats.enrollmentGrowth) %>
                    </span>
                        </div>

                        <span class="stat-label">Enrollments</span>

                        <div class="stat-value"><%= stats.totalEnrollments %></div>

                        <span class="stat-description">
                    <%= stats.enrollmentsThisMonth %> added this month
                </span>

                    </div>

                </div>


                <!-- CHART + QUICK ACTIONS -->
                <div class="dashboard-row">

                    <div class="panel revenue-panel">

                        <div class="panel-header">

                            <div>
                                <span class="panel-label">ENROLLMENT OVERVIEW</span>
                                <h3>Enrollment Performance</h3>
                            </div>

                        </div>

                        <div class="revenue-summary">
                            <strong><%= stats.totalEnrollments.toLocaleString() %></strong>
                            <span class="positive">Total enrollments</span>
                        </div>

                        <div class="chart">
                            <div class="chart-y">
                                <span><%= chartMaximum %></span>
                                <span><%= Math.ceil(chartMaximum * 2 / 3) %></span>
                                <span><%= Math.ceil(chartMaximum / 3) %></span>
                                <span>0</span>
                            </div>

                            <div class="chart-area">
                                <svg viewBox="0 0 700 260" preserveAspectRatio="none" class="revenue-chart">
                                    <defs>
                                        <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-opacity=".20"/>
                                            <stop offset="100%" stop-opacity="0"/>
                                        </linearGradient>
                                    </defs>
                                    <path class="chart-fill" d="<%= chartFill %>"/>
                                    <path class="chart-line" d="<%= chartLine %>"/>
                                </svg>

                                <div class="chart-months">
                                    <% stats.enrollmentChart.forEach((month) => { %>
                                        <span><%= month.month %></span>
                                    <% }); %>
                                </div>
                            </div>
                        </div>

                    </div>


                    <!-- QUICK ACTIONS -->
                    <div class="panel quick-panel">

                        <div class="panel-header">

                            <div>
                                <span class="panel-label">QUICK ACTIONS</span>
                                <h3>Manage Academy</h3>
                            </div>

                        </div>

                        <div class="quick-actions">

                            <a href="/admin/courses/upload" class="quick-action">
                                <div class="quick-icon">
                                    <i class="fa-solid fa-plus"></i>
                                </div>

                                <div>
                                    <strong>Create Course</strong>
                                    <span>Add a new course</span>
                                </div>

                                <i class="fa-solid fa-arrow-right"></i>
                            </a>


                            <a href="/admin/courses" class="quick-action">
                                <div class="quick-icon">
                                    <i class="fa-solid fa-layer-group"></i>
                                </div>

                                <div>
                                    <strong>Manage Courses</strong>
                                    <span>Edit existing courses</span>
                                </div>

                                <i class="fa-solid fa-arrow-right"></i>
                            </a>


                            <a href="/admin/students" class="quick-action">
                                <div class="quick-icon">
                                    <i class="fa-solid fa-users"></i>
                                </div>

                                <div>
                                    <strong>View Students</strong>
                                    <span>Manage academy students</span>
                                </div>

                                <i class="fa-solid fa-arrow-right"></i>
                            </a>


                            <a href="/admin/payments" class="quick-action">
                                <div class="quick-icon">
                                    <i class="fa-solid fa-wallet"></i>
                                </div>

                                <div>
                                    <strong>Transactions</strong>
                                    <span>View recent payments</span>
                                </div>

                                <i class="fa-solid fa-arrow-right"></i>
                            </a>

                        </div>

                    </div>

                </div>


                <!-- LOWER ROW -->
                <div class="dashboard-row lower-row">

                    <!-- RECENT STUDENTS -->
                    <div class="panel students-panel">

                        <div class="panel-header">

                            <div>
                                <span class="panel-label">STUDENTS</span>
                                <h3>Recent Students</h3>
                            </div>

                            <a href="/admin/students" class="view-all">
                        View All
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                        </div>


                        <div class="student-list">
                            <% if (recentStudents.length) { %>
                                <% recentStudents.forEach((student) => { const studentName = student.name || "Student"; %>
                                    <div class="student-item">
                                        <div class="student-avatar"><%= studentInitials(studentName) %></div>
                                        <div class="student-details">
                                            <strong><%= studentName %></strong>
                                            <span><%= student.email || "Student account" %></span>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="student-item">
                                    <div class="student-details"><span>No students have registered yet.</span></div>
                                </div>
                            <% } %>
                        </div>

                    </div>


                    <!-- TOP COURSES -->
                    <div class="panel courses-panel">

                        <div class="panel-header">

                            <div>
                                <span class="panel-label">COURSES</span>
                                <h3>Top Performing Courses</h3>
                            </div>

                            <a href="/admin/courses" class="view-all">
                        View All
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                        </div>


                        <div class="course-list">
                            <% if (topCourses.length) { %>
                                <% topCourses.forEach((course, index) => { %>
                                    <div class="course-item">
                                        <div class="course-number"><%= String(index + 1).padStart(2, "0") %></div>
                                        <div class="course-info">
                                            <strong><%= course.title %></strong>
                                            <span><%= course.category || "Uncategorized" %></span>
                                        </div>
                                        <div class="course-revenue">
                                            <strong><%= course.enrollmentCount.toLocaleString() %></strong>
                                            <span>Enrollments</span>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="course-item">
                                    <div class="course-info"><span>No courses have been added yet.</span></div>
                                </div>
                            <% } %>
                        </div>

                    </div>

                </div>


                <!-- FOOTER -->
                <footer class="dashboard-footer">

                    <span>
                © 2026 <strong>XTP Concept Academy</strong>. All rights reserved.
            </span>

                    <div>
                        <span>Admin Portal</span>
                        <span>•</span>
                        <span>Version 1.0.4</span>
                    </div>

                </footer>

            </section>

        </main>


    </div>

    <script src="/js/admin.js"></script>

</body>

</html>