<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | XTP Concept Academy</title>

    <meta name="description" content="Login to your XTP Concept Academy account and continue learning.">

    <link rel="stylesheet" href="/css/login.css">

</head>


<body>


    <!-- =====================================================
         LOGIN PAGE
    ====================================================== -->

    <main class="login-page">


        <!-- =================================================
             LEFT BRANDING SECTION
        ================================================== -->

        <section class="login-brand">

            <div class="brand-content">


                <!-- Brand -->

                <a href="/" class="brand-logo">

                    <div class="logo-box">
                        X
                    </div>

                    <div class="brand-name">

                        <strong>XTP</strong>

                        <span>
                            Concept Academy
                        </span>

                    </div>

                </a>


                <!-- Main Message -->

                <div class="brand-message">

                    <span class="brand-badge">
                        WELCOME BACK
                    </span>


                    <h1>

                        Continue your
                        <span>learning journey.</span>

                    </h1>


                    <p>

                        Sign in to access your courses, track your progress, and continue building the skills that matter.

                    </p>

                </div>


                <!-- Benefits -->

                <div class="brand-benefits">


                    <div class="benefit">

                        <div class="benefit-icon">
                            ✓
                        </div>

                        <div>

                            <strong>
                                Your Courses
                            </strong>

                            <p>
                                Access the courses you have purchased and enrolled in.
                            </p>

                        </div>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            ✓
                        </div>

                        <div>

                            <strong>
                                Track Your Progress
                            </strong>

                            <p>
                                Continue from where you stopped learning.
                            </p>

                        </div>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            ✓
                        </div>

                        <div>

                            <strong>
                                Learn Without Limits
                            </strong>

                            <p>
                                Build practical skills and move closer to your goals.
                            </p>

                        </div>

                    </div>


                </div>

            </div>

        </section>



        <!-- =================================================
             LOGIN FORM SECTION
        ================================================== -->

        <section class="login-section">


            <div class="login-container">


                <!-- Mobile Brand -->

                <a href="/" class="mobile-brand">

                    <div class="logo-box">
                        X
                    </div>

                    <div class="brand-name">

                        <strong>
                            XTP
                        </strong>

                        <span>
                            Concept Academy
                        </span>

                    </div>

                </a>



                <!-- Header -->

                <div class="form-header">

                    <span class="form-label">
                        MEMBER LOGIN
                    </span>


                    <h2>
                        Welcome back
                    </h2>


                    <p>
                        Sign in to continue your learning journey with XTP Concept Academy.
                    </p>

                </div>



                <!-- =================================================
                     ERROR MESSAGE
                ================================================== -->

                <% if (typeof error !== 'undefined' && error) { %>

                    <div class="alert alert-error">

                        <div class="alert-icon">
                            !
                        </div>

                        <div>

                            <strong>
                                Login failed
                            </strong>

                            <p>
                                <%= error %>
                            </p>

                        </div>

                    </div>

                    <% } %>



                        <!-- =================================================
                     SUCCESS MESSAGE
                ================================================== -->

                        <% if (typeof success !== 'undefined' && success) { %>

                            <div class="alert alert-success">

                                <div class="alert-icon">
                                    ✓
                                </div>

                                <div>

                                    <strong>
                                Success
                            </strong>

                                    <p>
                                        <%= success %>
                                    </p>

                                </div>

                            </div>

                            <% } %>



                                <!-- =================================================
                     LOGIN FORM
                ================================================== -->

                                <form action="/login" method="POST" class="login-form" id="loginForm">


                                    <!-- Email -->

                                    <div class="form-group">

                                        <label for="email">
                            Email Address
                        </label>


                                        <div class="input-wrapper">


                                            <span class="input-icon">

                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >

                                    <rect
                                        x="3"
                                        y="5"
                                        width="18"
                                        height="14"
                                        rx="2"
                                    />

                                    <path
                                        d="m3 7 9 6 9-6"
                                    />

                                </svg>

                            </span>


                                            <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>

                                        </div>

                                    </div>



                                    <!-- Password -->

                                    <div class="form-group">


                                        <div class="label-row">

                                            <label for="password">
                                Password
                            </label>


                                            <a href="/forgot-password" class="forgot-link">
                                Forgot password?
                            </a>

                                        </div>


                                        <div class="input-wrapper">


                                            <span class="input-icon">

                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >

                                    <rect
                                        x="4"
                                        y="10"
                                        width="16"
                                        height="11"
                                        rx="2"
                                    />

                                    <path
                                        d="M8 10V7a4 4 0 0 1 8 0v3"
                                    />

                                </svg>

                            </span>


                                            <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>


                                            <button type="button" class="password-toggle" id="passwordToggle" aria-label="Show password">

                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >

                                    <path
                                        d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"
                                    />

                                    <circle
                                        cx="12"
                                        cy="12"
                                        r="3"
                                    />

                                </svg>

                            </button>

                                        </div>

                                    </div>



                                    <!-- Remember Me -->

                                    <div class="remember-row">


                                        <label class="remember-container">

                            <input
                                type="checkbox"
                                name="remember"
                                id="remember"
                            >

                            <span class="custom-checkbox">
                                ✓
                            </span>

                            <span>
                                Remember me
                            </span>

                        </label>


                                    </div>



                                    <!-- Login Button -->

                                    <button type="submit" class="login-button" id="loginButton">

                        <span>
                            Sign In
                        </span>


                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >

                            <path
                                d="M5 12h14"
                            />

                            <path
                                d="m13 6 6 6-6 6"
                            />

                        </svg>

                    </button>


                                </form>



                                <!-- Register -->

                                <div class="register-prompt">

                                    Don't have an account?

                                    <a href="/register">
                        Create an account
                    </a>

                                </div>



                                <!-- Divider -->

                                <div class="divider">

                                    <span></span>

                                    <p>
                                        SECURE LOGIN
                                    </p>

                                    <span></span>

                                </div>



                                <!-- Security -->

                                <div class="security-notice">


                                    <div class="security-icon">

                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                            <rect
                                x="4"
                                y="10"
                                width="16"
                                height="11"
                                rx="2"
                            />

                            <path
                                d="M8 10V7a4 4 0 0 1 8 0v3"
                            />

                        </svg>

                                    </div>


                                    <div>

                                        <strong>
                            Your account is protected
                        </strong>

                                        <p>
                                            Your login information is securely transmitted.
                                        </p>

                                    </div>


                                </div>



                                <!-- Footer -->

                                <footer class="login-footer">

                                    <p>

                                        ©
                                        <%= new Date().getFullYear() %>
                                            XTP Concept Academy. All rights reserved.

                                    </p>

                                </footer>


            </div>

        </section>


    </main>



    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>
        /* =================================================
                                           PASSWORD VISIBILITY
                                        ================================================== */

        const password =
            document.getElementById("password");

        const passwordToggle =
            document.getElementById("passwordToggle");


        passwordToggle.addEventListener(
            "click",
            () => {

                const isPassword =
                    password.type === "password";


                password.type =
                    isPassword ?
                    "text" :
                    "password";


                passwordToggle.setAttribute(
                    "aria-label",
                    isPassword ?
                    "Hide password" :
                    "Show password"
                );

            }
        );



        /* =================================================
           LOGIN BUTTON LOADING STATE
        ================================================== */

        const loginForm =
            document.getElementById("loginForm");

        const loginButton =
            document.getElementById("loginButton");


        loginForm.addEventListener(
            "submit",
            () => {

                if (!loginForm.checkValidity()) {
                    return;
                }


                loginButton.classList.add("loading");

                loginButton.querySelector(
                    "span"
                ).textContent = "Signing in...";


                loginButton.disabled = true;

            }
        );
    </script>


</body>

</html>